# Supabase Configuration
# Obten estos valores desde tu panel de Supabase: Project Settings > API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Si estas credenciales se dejan vacías, la arquitectura limpia de Le Désir
# entra automáticamente en modo Fallback / Mock Repository usando los datos iniciales,
# asegurando que la web y los endpoints funcionen al 100% de manera local y en preview.
